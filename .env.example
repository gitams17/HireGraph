# Local development only. Copy this file to .env and update secrets as needed.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

POSTGRES_DB=hireflow
POSTGRES_USER=hireflow
POSTGRES_PASSWORD=local-db-password-change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-password-change-me

# Non-secret frontend URL. Copy into frontend/.env.local after Next.js is created.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
